# /etc/config/ratan-qos -- RATAN QoS shaping config.
#
# Per-WAN: declare each WAN's egress iface and total capacity (kbit/s).
# Globally: realtime floor (per WAN) and background ceiling (% of total).

config qos 'main'
	option enabled '1'
	# Per-WAN bandwidth guarantee for the realtime class (VideoCall/*,
	# VoIP/*). At least one Teams HD stream (~1.2 Mbps) fits in 1500 kbit.
	option realtime_min_kbps '1500'
	# Background class can use at most this percentage of the link, so a
	# big backup can't push realtime out of its floor.
	option bg_ceil_pct '20'

# Edit these to match the actual WAN ifaces and capacities. The procd
# init re-applies on changes (uci commit + /etc/init.d/ratan-qos reload).

config wan 'starlink'
	option iface 'wan0'
	# Honest typical Starlink throughput. Set conservatively so HTB
	# can actually enforce the ceiling against bufferbloat -- if the
	# link's real cap is 250 Mbps, set total_kbps to 200000 (80%) to
	# keep the queue at the router rather than at the cellular tower.
	option total_kbps '200000'

config wan 'cellular'
	option iface 'wan1'
	option total_kbps '50000'
