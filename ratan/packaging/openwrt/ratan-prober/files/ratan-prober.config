# /etc/config/ratan-prober
#
# Configure 'main' with the VPS endpoint, then one 'wan' section per
# physical interface, listing its MPTCP subflow index (matches what
# mptcpd / ip mptcp endpoint advertises).

config main 'main'
	option enabled '1'
	option server ''               # required: VPS hostname or IPv4
	option port '5555'
	option interval_ms '50'
	option timeout_ms '200'
	option failover_n '3'
	option base_weight '50'
	option samples_sock '/run/ratan/samples.sock'
	option weights_map '/sys/fs/bpf/ratan/path_weights'

# Example -- uncomment and edit. The subflow_idx must match the order in
# which mptcpd registers the endpoints; check with: ip mptcp endpoint show
#
# config wan 'starlink'
#     option iface 'wan0'
#     option subflow_idx '0'
#
# config wan 'cellular'
#     option iface 'wan1'
#     option subflow_idx '1'
