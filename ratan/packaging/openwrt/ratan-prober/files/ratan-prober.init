#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0
#
# procd init for ratan-prober.
# Reads /etc/config/ratan-prober, builds argv, supervises the daemon.

START=80      # after ratan-sched (70); BPF map must exist
STOP=20
USE_PROCD=1

PROG="/usr/sbin/ratan_prober"

start_service() {
	local server port interval timeout failover base samples_sock weights_map enabled

	config_load 'ratan-prober'
	config_get_bool enabled main enabled 1
	[ "$enabled" = "0" ] && {
		logger -t ratan-prober "disabled in /etc/config/ratan-prober"
		return 0
	}

	config_get server         main server         ''
	config_get port           main port           '5555'
	config_get interval       main interval_ms    '50'
	config_get timeout        main timeout_ms     '200'
	config_get failover       main failover_n     '3'
	config_get base           main base_weight    '50'
	config_get samples_sock   main samples_sock   '/run/ratan/samples.sock'
	config_get weights_map    main weights_map    '/sys/fs/bpf/ratan/path_weights'

	[ -z "$server" ] && {
		logger -t ratan-prober "FATAL: 'server' not configured"
		return 1
	}

	# Wait briefly for the pinned BPF map to appear (ratan-sched starts first
	# but may still be initializing at our start time).
	local tries=20
	while [ $tries -gt 0 ] && [ ! -e "$weights_map" ]; do
		sleep 0.25
		tries=$((tries - 1))
	done
	[ -e "$weights_map" ] || {
		logger -t ratan-prober "FATAL: $weights_map missing (ratan-sched not loaded?)"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		--server "$server" \
		--port "$port" \
		--interval-ms "$interval" \
		--timeout-ms "$timeout" \
		--failover-n "$failover" \
		--base-weight "$base" \
		--samples-sock "$samples_sock" \
		--weights-map "$weights_map" \
		--foreground

	# Add one --wan IFACE:IDX per configured 'wan' section.
	add_wan() {
		local sect="$1"
		local iface idx
		config_get iface "$sect" iface ''
		config_get idx   "$sect" subflow_idx ''
		[ -n "$iface" ] && [ -n "$idx" ] && \
			procd_append_param command --wan "${iface}:${idx}"
	}
	config_foreach add_wan wan

	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_close_instance
}

stop_service() {
	# Nothing extra; procd handles SIGTERM to the daemon.
	:
}

service_triggers() {
	procd_add_reload_trigger "ratan-prober"
}
