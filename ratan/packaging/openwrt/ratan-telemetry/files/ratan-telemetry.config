# /etc/config/ratan-telemetry

config main 'main'
	option enabled '1'
	option db '/var/lib/ratan/telemetry.db'
	option sock '/run/ratan/telemetry.sock'
	option schema '/usr/share/ratan/schema.sql'
	# By default we bind to localhost only. The LuCI app on the router
	# reaches us through 127.0.0.1; ratan-relay-client also runs locally.
	# Set http_host to 0.0.0.0 only if you really want a directly-exposed
	# HTTP API (then add an auth layer).
	option http_host '127.0.0.1'
	option http_port '9180'
	# dnsmasq lease file watched by the in-process discovery thread.
	# /tmp/dhcp.leases is OpenWrt's default. The thread also subscribes
	# to RTNETLINK (LINK/ADDR/NEIGH) so the UI sees the current set of
	# WAN interfaces, IP addresses, and LAN neighbors without polling.
	option lease_file '/tmp/dhcp.leases'
